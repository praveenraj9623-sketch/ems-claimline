# Required for Chat and post-call review
GROQ_API_KEY=

# Required for spoken browser replies
DEEPGRAM_API_KEY=

# HuskyVoice calls
HUSKYVOICE_API_KEY=
HUSKYVOICE_AGENT_ID=
CALL_TO_NUMBER=

# Optional legacy Twilio calling
# VOICE_TRANSPORT=twilio
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
VOICE_PUBLIC_URL=https://your-ngrok-domain.ngrok-free.app

# Optional model overrides
# GROQ_MODEL=your_extraction_model
# GROQ_REVIEW_MODEL=your_reviewer_model
# GROQ_STT_MODEL=whisper-large-v3-turbo
# DEEPGRAM_STT_MODEL=your_transcription_model
# DEEPGRAM_TTS_MODEL=your_synthesis_model
