# Copy this file to .env and fill it in. Never share or commit .env.

# --- AI reviewer (Step 3). Optional: without it the transcript audit alone scores the call.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REVIEW_MODEL=

# --- Phone calls (Twilio). Needed only for the "Call my phone" tab.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
CALL_TO_NUMBER=+91XXXXXXXXXX
# Your ngrok https address (optional: if ngrok is running it is detected automatically)
# PUBLIC_BASE_URL=https://your-name.ngrok-free.app
# For the 75-minute Voice trial proxy, enable trial mode and generate a private random token.
# The app adds this token to the answer, speech, and status callback URLs automatically.
# TWILIO_TRIAL_MODE=true
# TWILIO_TRIAL_WEBHOOK_TOKEN=

# --- Optional
# TTS_VOICE=Polly.Joanna-Neural
# PORT=8000
# STREAMLIT_PORT=8501   (only if you run Streamlit on a different port)
